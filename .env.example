# Credencial administrativa (rol con CREATEDB/CREATEROLE/DDL) — usada por
# `prisma migrate deploy`, los seeds y los scripts de prisma/db-fixes/.
# NUNCA se configura en Vercel (ver docs/FASE22A_HARDENING_ACCESO_NEON.md).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname?sslmode=require"

# Credencial de runtime (rol restringido: solo SELECT/INSERT/UPDATE/DELETE,
# sin DDL) — la usa la app en producción (src/lib/prisma.ts). Si no se
# define, la app cae de vuelta a DATABASE_URL (conveniente en desarrollo
# local, donde no hace falta la separación).
DATABASE_URL_RUNTIME="postgresql://app_runtime:password@host-pooler:5432/dbname?sslmode=require"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Vercel Blob — habilitar "Blob" en el dashboard del proyecto en Vercel y
# copiar el token generado. Sin esto, la subida de fotos de obra
# (ProjectPhoto) falla con un error claro; el resto del sitio funciona igual.
BLOB_READ_WRITE_TOKEN=""
