// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  image        String?
  passwordHash String?
  role         Role    @default(user)

  savedProjects                 SavedProject[]
  shoppingListChecks            ShoppingListCheck[]
  planPhaseCompletions          ProjectPlanPhaseCompletion[]
  projectPhotos                 ProjectPhoto[]
  projectShowcases              ProjectShowcase[]
  regularizationCases           RegularizationCase[]
  regularizationStepCompletions RegularizationStepCompletion[]
  regularizationDocumentChecks  RegularizationDocumentCheck[]
  inspectionCases               InspectionCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model SavedProject {
  id       String            @id @default(cuid())
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  module   Module            @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  moduleId String
  // Presentes solo si el proyecto se guardó desde una fase de /plan/[slug]
  // (ver ResultScreen.handleSaveProject) — permiten a una fase posterior del
  // mismo plan (ej. Sendero en "Terminar el entorno") ubicar los datos
  // guardados de una fase anterior (ej. Piscina rectangular) para prellenar
  // un valor derivado, sin necesitar una feature genérica de memoria entre
  // fases.
  plan     ProjectPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId   String?
  phase    ProjectPlanPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  phaseId  String?

  name            String
  // Respuestas del wizard y resultado calculado, guardados como snapshot —
  // el detalle del proyecto no recalcula contra el módulo actual.
  answers         Json
  result          Json
  progressPercent Int     @default(0)
  // Incluido en /lista-compras (consolidación de materiales entre proyectos).
  inShoppingList  Boolean @default(false)

  photos    ProjectPhoto[]
  showcases ProjectShowcase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([moduleId])
  @@index([planId, moduleId])
  @@map("saved_projects")
}

// Estado de "comprado" por línea consolidada de la lista de compras.
// La identidad de una línea es (materialName, unit) tal como aparece en el
// snapshot de CalculationResult — no un Material.id, porque el nombre puede
// venir de un materialLabelTemplate dinámico sin fila de Material fija.
model ShoppingListCheck {
  id           String  @id @default(cuid())
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  materialName String
  unit         String
  checked      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, materialName, unit])
  @@index([userId])
  @@map("shopping_list_checks")
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  tag         String?
  order       Int      @default(0)
  modules     Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Module {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String
  // Texto libre opcional para mejorar el buscador de la Home sin depender
  // solo del nombre/descripción exactos (ej. "radier patio piso hormigón").
  searchKeywords String?
  // Imagen de portada del proyecto/calculadora, reutilizada por igual en
  // Inicio, categorías, búsqueda y cualquier otra tarjeta que lo represente
  // — un solo campo por módulo en vez de una imagen distinta por página.
  // Null hasta que exista contenido fotográfico real (fase 2, fuera de
  // alcance de esta homogeneización visual).
  imageUrl       String?
  version        Int      @default(1)
  published      Boolean  @default(false)
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId     String

  questions        Question[]
  variables        Variable[]
  formulas         Formula[]
  lossFactors      LossFactor[]
  savedProjects    SavedProject[]
  projectTaskLinks ProjectTaskModule[]
  planPhaseLinks   ProjectPlanPhaseModule[]
  photos           ProjectPhoto[]
  // Contenido "resultado enriquecido" opcional (piloto, ver ModuleGuide) —
  // hoy solo existe para Radier, no se genera en vivo por IA.
  guide            ModuleGuide?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("modules")
}

// Contenido editorial estático que acompaña el resultado de un módulo
// (piloto de "resultado enriquecido"): consejos prácticos redactados a
// mano, no generados en vivo por IA. Relación 1:1 opcional — la mayoría de
// los módulos no la tienen. `faqs` es un array JSON de {question, answer}.
model ModuleGuide {
  id       String @id @default(cuid())
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String @unique

  summary               String
  tools                 String[]
  estimatedTime         String
  difficulty            String
  recommendedPeople     String
  tipsBeforeStart       String[]
  commonMistakes        String[]
  safetyRecommendations String[]
  bestPractice          String
  masterTip             String
  faqs                  Json
  stepByStepSummary     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("module_guides")
}

enum QuestionType {
  NUMBER
  SELECT
  TEXT
}

model Question {
  id                   String       @id @default(cuid())
  module               Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId             String
  key                  String
  label                String
  type                 QuestionType
  unit                 String?
  helpText             String?
  order                Int          @default(0)
  // Preguntas del mismo módulo que comparten este valor se renderizan juntas
  // en un solo paso del wizard (ver docs/formula-dsl.md).
  stepGroup            String?
  // Visibilidad condicional: si están seteados, esta pregunta solo se
  // muestra (y se pide) cuando la respuesta a la pregunta
  // visibleIfQuestionKey esté dentro de visibleIfValues. Sin admin UI
  // todavía — se configura por script (ver docs/formula-dsl.md).
  visibleIfQuestionKey String?
  visibleIfValues      String[]     @default([])
  // Valor que se asigna automáticamente a esta pregunta cuando queda
  // oculta por visibleIf (no se le pregunta al usuario) — para que las
  // fórmulas/lookups que dependen de su respuesta sigan funcionando con
  // un valor por defecto en vez de quedar sin resolver. Ej.: "colocacion"
  // oculta cuando metodo_hormigon=manual asume "manual_carretilla".
  hiddenDefaultValue   String?

  // Valor sugerido (editable) para precargar el campo NUMBER, calculado por
  // LOOKUP contra la respuesta de otra pregunta ya contestada — ej. sugerir
  // dimensiones típicas de fundación según el "uso" elegido. Sin admin UI
  // todavía — se configura por script. Forma: { type: "LOOKUP", questionKey,
  // table: { [answerKey]: number } }.
  defaultSource Json?

  options QuestionOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moduleId, key])
  @@index([moduleId])
  @@map("questions")
}

model QuestionOption {
  id           String   @id @default(cuid())
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId   String
  key          String
  label        String
  order        Int      @default(0)
  // Descripción corta (1-2 líneas) opcional para la variante visual con
  // foto (ver ImageOptionCard) — sin admin UI todavía, se configura por
  // script. Si una opción no la tiene, esa pregunta cae al layout de lista
  // de texto plano de siempre.
  description  String?
  // URL de la foto opcional para la variante visual con foto. Cuando TODAS
  // las opciones de una pregunta SELECT tienen imageUrl, QuestionStep
  // renderiza ImageOptionCard en vez de la lista de botones de texto plano
  // — esto la hace opt-in por pregunta sin flag adicional.
  imageUrl     String?
  // Valor numérico opcional que esta opción representa (ej. la opción
  // "10cm" de una pregunta SELECT de espesor vale 0.1, en metros) — spec
  // "ObraBien Calculadora - Flujo rediseñado" (Fase 4, 2026-08-02): permite
  // que el motor de diagramas (DiagramV2) dibuje una dimensión que el
  // usuario elige de una lista fija en vez de tipear un NUMBER libre (ej.
  // Losa/Muro de hormigón armado, donde el espesor son opciones técnicas
  // predefinidas, no un valor arbitrario). Puramente de presentación — el
  // motor de fórmulas sigue resolviendo espesor_metros con su propio
  // LOOKUP en la Variable, independiente de este campo.
  numericValue Float?

  @@unique([questionId, key])
  @@map("question_options")
}

enum VariableValueType {
  NUMBER
  TEXT
}

// source: ver docs/formula-dsl.md
model Variable {
  id        String            @id @default(cuid())
  module    Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId  String
  key       String
  label     String            @default("")
  valueType VariableValueType
  source    Json
  // Si es true, el valor resuelto de esta variable se muestra en el resultado
  // (ej: "Tipo de hormigón: G20"), no solo las cantidades de las fórmulas.
  isResult  Boolean           @default(false)
  norm      Norm?             @relation(fields: [normId], references: [id], onDelete: SetNull)
  normId    String?
  order     Int               @default(0)

  @@unique([moduleId, key])
  @@index([moduleId])
  @@map("variables")
}

// Catálogo global de materiales, reutilizable entre módulos.
model Material {
  id                 String  @id @default(cuid())
  key                String  @unique
  name               String
  unit               String
  // Precio de referencia aproximado en CLP por unidad (tabla estática,
  // actualizada a mano — NO precios en vivo). Se precarga como sugerencia
  // editable en el campo de precio del resultado, solo cuando la unidad
  // de la línea coincide con la del material. referencePriceNote lleva el
  // texto visible con fuente y fecha ("Precio de referencia aproximado
  // (Sodimac, jul 2026)...").
  referencePrice     Int?
  referencePriceNote String?

  formulas Formula[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("materials")
}

// Catálogo de dosificación (proporción volumétrica cemento:arena:gravilla)
// por grado de hormigón — spec "ObraBien Calculadora - Flujo rediseñado"
// (2026-08-02, decisión de producto: "la dosificación pertenece al grado
// del hormigón y no al módulo"). `gradeCode` es el MISMO string que ya
// produce el LOOKUP2 de la Variable "tipo_hormigon" en cada módulo de
// hormigón (ej. "G17-N (equivalente al H20 antiguo)") — así un módulo solo
// necesita buscar por ese valor, sin ningún vínculo nuevo a Module. Mismo
// patrón que Material.referencePrice: catálogo de referencia estático,
// administrado a mano, no un cálculo del DSL — el motor de fórmulas no lo
// toca. Pensado para reutilizarse en resultado, PDF, guía práctica y
// futuras recomendaciones sin duplicar esta proporción por módulo.
model ConcreteMixRatio {
  id          String  @id @default(cuid())
  gradeCode   String  @unique
  cementParts Float
  sandParts   Float
  gravelParts Float
  norm        Norm?   @relation(fields: [normId], references: [id])
  normId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("concrete_mix_ratios")
}

// expression / condition: ver docs/formula-dsl.md
model Formula {
  id                    String    @id @default(cuid())
  module                Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId              String
  key                   String
  label                 String
  unit                  String
  expression            Json
  condition             Json?
  isResult              Boolean   @default(true)
  // Resultado secundario/de referencia (ej. "equivale a X sacos") — se
  // renderiza más chico, anidado dentro de la tarjeta del resultado
  // principal inmediatamente anterior, no como su propia tarjeta.
  isSecondary           Boolean   @default(false)
  note                  String?
  material              Material? @relation(fields: [materialId], references: [id])
  materialId            String?
  // Plantilla opcional para el nombre de material mostrado en el resultado,
  // con placeholders {variableKey} interpolados con los valores de variable
  // ya resueltos al momento del cálculo (ver docs/formula-dsl.md). Si está
  // presente, reemplaza a material.name — útil cuando el nombre depende de
  // varias variables de selección (medida, espesor, etc.) y crear un
  // Material por combinación sería inviable.
  materialLabelTemplate String?
  norm                  Norm?     @relation(fields: [normId], references: [id], onDelete: SetNull)
  normId                String?
  order                 Int       @default(0)

  @@unique([moduleId, key])
  @@index([moduleId])
  @@map("formulas")
}

// condition: ver docs/formula-dsl.md
model LossFactor {
  id         String  @id @default(cuid())
  module     Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId   String
  key        String
  label      String
  percentage Float
  condition  Json?
  norm       Norm?   @relation(fields: [normId], references: [id], onDelete: SetNull)
  normId     String?

  @@unique([moduleId, key])
  @@index([moduleId])
  @@map("loss_factors")
}

enum NormVerificationStatus {
  // El valor está citado con una fuente normativa/técnica identificada.
  CITADO
  // Es práctica de obra habitual; no se ha verificado contra una norma o
  // guía técnica específica todavía.
  PRACTICA_GENERAL_NO_VERIFICADA
}

// Catálogo de normas/fuentes técnicas citadas por variables, fórmulas o
// factores de pérdida. Ver docs/auditoria-normativa.md.
model Norm {
  id                 String                 @id @default(cuid())
  code               String                 @unique
  title              String
  year               Int?
  scope              String
  verificationStatus NormVerificationStatus
  note               String?
  // Marca normas cuya nota exige explícitamente el criterio de un
  // profesional habilitado (elemento estructural o instalación regulada:
  // Vigas, Losas, Fierros, Gas, etc.) — usado para agregar una advertencia
  // reforzada al prompt de IA generado desde el resultado.
  reinforcedWarning  Boolean                @default(false)

  // Valor de referencia administrable citado por esta norma (ej. la UF
  // histórica a una fecha de corte legal) — nullable porque la mayoría de
  // las normas técnicas citadas hoy no tienen un valor numérico propio,
  // solo describen un criterio (ver Variable/Formula/LossFactor, que
  // citan a Norm sin necesitar este campo). `valueUnit` documenta la
  // unidad de `value` (ej. "CLP", "UF") — ambos nullable y aditivos,
  // agregados para reutilizar este catálogo en vez de crear una tabla
  // nueva para "valores de referencia con fuente citada" (ver decisión
  // de arquitectura de Regularización, 2026-08-01).
  value     Float?
  valueUnit String?

  variables         Variable[]
  formulas          Formula[]
  lossFactors       LossFactor[]
  concreteMixRatios ConcreteMixRatio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("norms")
}

// Fase 2 — capa de descubrimiento por proyecto sobre la Home, encima de
// Category/Module (que no se tocan). Ver docs/fase2-home-por-proyecto.md
// si se agrega más adelante.
model ProjectGroup {
  id    String  @id @default(cuid())
  slug  String  @unique
  name  String
  icon  String
  order Int     @default(0)
  // Tono especial de presentación (ej. "avanzado" para "Herramientas
  // avanzadas" — tratamiento visual más discreto en la Home).
  tone  String?

  tasks ProjectTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_groups")
}

model ProjectTask {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  order       Int          @default(0)
  group       ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId     String
  // Descripción corta (1-2 líneas) y foto opcionales para la variante
  // visual con foto en /grupos/[slug] (ver TaskPhotoCard) — sin admin UI
  // todavía, se configuran por script. Si la tarea tiene un solo
  // moduleLink, esta es la tarjeta; si tiene varios, cada
  // ProjectTaskModule trae su propia foto/descripción en su lugar (ver
  // abajo) y estos 2 campos no se usan.
  description String?
  imageUrl    String?

  moduleLinks  ProjectTaskModule[]
  // Si está seteado, /empezar/[slug] redirige directo a /guias-rapidas/[quickGuide.slug]
  // en vez de resolver moduleLinks — una tarea usa moduleLinks O quickGuide, no ambos.
  quickGuide   QuickGuide?         @relation(fields: [quickGuideId], references: [id], onDelete: SetNull)
  quickGuideId String?
  // Si está seteado, /empezar/[slug] redirige directo a /plan/[plan.slug] (piloto de
  // "Plan de fases" para proyectos compuestos) — una tarea usa moduleLinks O
  // quickGuide O plan, nunca más de uno a la vez.
  plan         ProjectPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@map("project_tasks")
}

// Guía práctica autocontenida sin cálculo de materiales (1-2 piezas, nada
// que cuantificar) — a diferencia de Module, no tiene preguntas ni
// fórmulas. Ver /guias-rapidas/[slug].
model QuickGuide {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  shortDescription      String
  tools                 String[]
  estimatedTime         String
  difficulty            String
  peopleNeeded          String
  steps                 String[]
  tips                  String[]
  commonMistakes        String[]
  masterTip             String
  faqs                  Json
  // Mismo patrón que Norm.reinforcedWarning — advertencia destacada para
  // trabajos que involucran electricidad viva o riesgo similar.
  reinforcedWarning     Boolean  @default(false)
  reinforcedWarningText String?
  order                 Int      @default(0)

  tasks               ProjectTask[]
  regularizationSteps RegularizationStepGuide[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quick_guides")
}

// Vincula una ProjectTask a uno o más Module existentes. Si una tarea
// tiene 2+ links, la página /empezar/[taskSlug] muestra un selector; si
// tiene 1 solo, redirige directo al módulo.
model ProjectTaskModule {
  id          String      @id @default(cuid())
  task        ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  module      Module      @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  moduleId    String
  // Etiqueta para desambiguar cuando hay 2+ módulos (ej. "Rectangular").
  label       String?
  // Query string opcional a anexar al entrar al módulo (ej.
  // "tipo=bodega_industrial"), para preseleccionar la primera pregunta.
  presetQuery String?
  order       Int         @default(0)
  // Descripción corta y foto opcionales para cuando ESTE link se muestra
  // como su propia tarjeta en /grupos/[slug] — solo aplica si la
  // ProjectTask tiene 2+ moduleLinks (ej. "Piscina rectangular" /
  // "Piscina circular" dentro de la tarea "Construir una piscina"); con
  // un solo link, la foto/descripción vive en ProjectTask en su lugar.
  description String?
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([moduleId])
  @@map("project_task_modules")
}

// Piloto de "Plan de fases": capa encima de Module, igual criterio que
// ProjectGroup/ProjectTask — una secuencia ordenada de fases para un
// proyecto compuesto (ej. "Construir una bodega o ampliación"), en vez de
// la lista plana de accesos a módulos sin secuencia real que usaba
// ProjectTaskModule para este caso. Un solo piloto por ahora: no
// generalizar a otros ProjectTask sin validar el patrón primero.
model ProjectPlan {
  id          String @id @default(cuid())
  slug        String @unique
  title       String
  description String

  phases        ProjectPlanPhase[]
  tasks         ProjectTask[]
  savedProjects SavedProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("project_plans")
}

model ProjectPlanPhase {
  id     String      @id @default(cuid())
  plan   ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId String
  order  Int         @default(0)
  // Nombre en lenguaje cotidiano, ej. "1. Hacer la base".
  name   String

  moduleLinks   ProjectPlanPhaseModule[]
  completions   ProjectPlanPhaseCompletion[]
  savedProjects SavedProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@map("project_plan_phases")
}

// Mismo patrón que ProjectTaskModule: normalmente 1 módulo por fase, pero
// soporta 2+ para reutilizar el mismo selector de ambigüedad si alguna
// fase futura lo necesitara (no se ejercita en el piloto actual, donde
// las 3 fases mapean 1:1).
model ProjectPlanPhaseModule {
  id          String           @id @default(cuid())
  phase       ProjectPlanPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  phaseId     String
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  moduleId    String
  label       String?
  presetQuery String?
  order       Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phaseId])
  @@index([moduleId])
  @@map("project_plan_phase_modules")
}

// Estado manual de "fase lista" por usuario — un checkbox explícito, no
// una inferencia automática desde SavedProject (evita ambigüedad sobre
// qué cuenta como "completado"). Mismo patrón que ShoppingListCheck.
model ProjectPlanPhaseCompletion {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  phase     ProjectPlanPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  phaseId   String
  completed Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, phaseId])
  @@index([userId])
  @@map("project_plan_phase_completions")
}

enum ProjectPhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

// Foto de obra real subida por un usuario tras guardar un proyecto —
// contenido de terceros no revisado, nunca visible públicamente hasta
// que un admin la aprueba desde /admin/fotos. Con el tiempo arma una
// galería real por módulo que reemplaza fotos de stock.
model ProjectPhoto {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  // Proyecto desde el que se subió (para trazabilidad); si se borra el
  // proyecto la foto se conserva igual, solo pierde ese vínculo.
  savedProject   SavedProject? @relation(fields: [savedProjectId], references: [id], onDelete: SetNull)
  savedProjectId String?
  module         Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId       String

  url    String
  status ProjectPhotoStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId, status])
  @@index([userId])
  @@map("project_photos")
}

enum ProjectShowcaseStatus {
  PENDING
  APPROVED
  REJECTED
}

// Publicación en la galería pública de proyectos terminados (/galeria) —
// título + relato + fotos antes/después subidos por un usuario logueado.
// No visible públicamente hasta que un admin la aprueba desde
// /admin/proyectos-galeria. Distinto de ProjectPhoto: eso es una foto
// suelta ligada a un módulo; esto es una publicación completa, opcionalmente
// ligada al SavedProject desde el que se generó.
model ProjectShowcase {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  savedProject   SavedProject? @relation(fields: [savedProjectId], references: [id], onDelete: SetNull)
  savedProjectId String?

  title String
  story String

  photosBefore String[]
  photosAfter  String[]

  status ProjectShowcaseStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@map("project_showcases")
}

// ============================================================
// Regulariza tu Vivienda — arquitectura aprobada tras Fase 0
// (auditoría de reutilización) y Fase 1 (arquitectura conceptual,
// 3 rondas de decisiones documentadas). Ver docs/ para el detalle de
// cada decisión si hace falta reconstruir el porqué de una forma.
// ============================================================

enum RegularizationConstructionType {
  AMPLIACION
  SEGUNDO_PISO
  TERRAZA_CERRADA
  QUINCHO
  BODEGA
  ESTACIONAMIENTO_TECHADO
  VIVIENDA_COMPLETA
  OTRO
}

enum RegularizationMaterial {
  MADERA
  ALBANILERIA
  METALCON
  HORMIGON
  MIXTA
  OTRO
}

enum RegularizationCaseStatus {
  EN_PROGRESO
  EVALUACION_LISTA
  CARPETA_GENERADA
}

// Caso de regularización de un usuario — datos del wizard inicial +
// snapshot de las respuestas del checklist inteligente. Un usuario puede
// tener varios casos simultáneos (ver `name`, mismo patrón que
// SavedProject.name).
model RegularizationCase {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name String

  tipoConstruccion   RegularizationConstructionType
  // Nullable: "No lo sé" es una respuesta válida y distinta de un año real.
  // Cualquier RegularizationRule.condition que compare este valor
  // numéricamente debe usar {"op":"defined",...} como guard primero (mismo
  // criterio ya documentado en docs/formula-dsl.md para valores ausentes).
  anioConstruccion   Int?
  recepcionMunicipal Boolean?
  m2Estimados        Float
  material           RegularizationMaterial
  estadoProceso      RegularizationCaseStatus       @default(EN_PROGRESO)

  // Avalúo fiscal en pesos — un solo campo, sin equivalente en UF ni
  // campo de estado aparte (null ya representa "no lo sabe todavía", mismo
  // criterio que anioConstruccion/recepcionMunicipal). Se captura mediante
  // una pregunta de compuerta al inicio de la etapa de documentación, no
  // en el wizard inicial — decisión de UI, no de schema. Si en el futuro
  // se confirma que algún umbral legal requiere UF, se resuelve con un
  // valor de referencia administrado en BD (mismo patrón que
  // LossFactor.percentage), nunca con un segundo campo editable por el
  // usuario ni con conversión en tiempo real.
  avaluoFiscalPesos Float?

  // Snapshot de las respuestas del checklist inteligente a nivel de caso
  // (largo, ancho, altura, espesor de muro, techumbre, ventanas, puertas)
  // — mismo patrón que SavedProject.answers: Json, no una columna por
  // medida. Distinto de RegularizationRoom, que es la lista de recintos
  // para la calculadora de superficie, no las medidas generales del caso.
  medidas Json?

  rooms      RegularizationRoom[]
  photos     RegularizationPhoto[]
  sketch     RegularizationSketch?
  stepChecks RegularizationStepCompletion[]
  docChecks  RegularizationDocumentCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("regularization_cases")
}

enum RegularizationRoomType {
  DORMITORIO
  COCINA
  BANO
  LIVING_COMEDOR
  LAVANDERIA
  BODEGA
  OTRO
}

// Recinto individual con sus medidas — alimenta la calculadora de
// superficie (largo × ancho = m2Calculado). No confundir con
// RegularizationCase.medidas (medidas generales del caso, no por recinto).
model RegularizationRoom {
  id     String             @id @default(cuid())
  case   RegularizationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  roomType    RegularizationRoomType
  label       String?
  largo       Float
  ancho       Float
  m2Calculado Float
  order       Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("regularization_rooms")
}

enum RegularizationPhotoKind {
  FACHADA
  POSTERIOR
  COSTADO
  INTERIOR
  TECHUMBRE
  FUNDACION
  OTRO
}

// Fotos de respaldo del caso (fachada, interior, techumbre, etc.) — solo
// almacenamiento, sin análisis ni moderación (a diferencia de ProjectPhoto,
// esta documentación es privada del propio caso del usuario). Reutiliza el
// mecanismo de subida existente (Vercel Blob), no el modelo.
model RegularizationPhoto {
  id     String             @id @default(cuid())
  case   RegularizationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  kind    RegularizationPhotoKind
  url     String
  caption String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@map("regularization_photos")
}

// Estado de "paso completado" del checklist inteligente, por usuario y por
// caso — mismo patrón que ProjectPlanPhaseCompletion (boolean manual, no
// inferido), adaptado con caseId porque un usuario puede tener varios
// casos a la vez (ProjectPlanPhase no lo necesita porque cada fase ya
// pertenece a un único plan). stepKey es un identificador estable definido
// en código, sin catálogo propio — mismo criterio que Question.stepGroup.
model RegularizationStepCompletion {
  id     String             @id @default(cuid())
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  case   RegularizationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  stepKey   String
  completed Boolean @default(true)

  @@unique([userId, caseId, stepKey])
  @@map("regularization_step_completions")
}

enum RegularizationDocumentCategory {
  MUNICIPAL
  DOM
  ARQUITECTO
  NOTARIA_REGISTRO
}

// Modelo de tres ejes independientes — Fase 2 del plan de implementación
// del Informe de Evaluación Preliminar (ver
// docs/regularizacion-auditoria-funcional-normativa-ux.md y las 3
// especificaciones en la raíz del proyecto: diseno-informe-regularizacion.md,
// clasificacion-documentos-ley-20898.md, plan-implementacion-informe-
// regularizacion.md — fuente de verdad de este modelo). Reemplaza el
// booleano `obligatorio` plano: un documento puede ser mínimo y a la vez
// aportado por el usuario, por ejemplo — dos ejes distintos, no una sola
// etiqueta.
enum RegularizationDocObligatoriedad {
  MINIMO
  CONDICIONAL
}

enum RegularizationDocOrigen {
  USUARIO
  PROFESIONAL
  INSTITUCION
}

// El tercer eje: CUÁNDO ocurre un documento respecto del trámite, no solo
// si es condicional o quién lo aporta. Un documento `POSTERIOR` (ej.
// Certificado de Recepción Definitiva, pago de derechos municipales,
// inscripción CBR) nunca pertenece al checklist de entrada — se filtra
// automáticamente en getVisibleDocumentChecklist y se muestra solo en la
// sección "¿Qué Ocurre Después?" del informe.
enum RegularizationDocMomento {
  PREVIO
  DURANTE
  POSTERIOR
}

// Indica cuánto de este documento resuelve la propia plataforma — el
// argumento de valor del Informe de Evaluación Preliminar (ver sección
// "¿Qué Puede Hacer ObraBien por Ti?" del diseño).
enum RegularizationDocSoporteObraBien {
  GENERA_PLATAFORMA
  ORIENTA_ACCESO_DIRECTO
  GESTION_EXTERNA
}

enum RegularizationDocEstadoValidacion {
  PENDIENTE_VALIDACION_PROFESIONAL
  VALIDADO
}

// Catálogo de documentos requeridos para el trámite — contenido vive en
// BD, no hardcodeado en componentes (principio Database First). `dependeDe`
// usa el mismo formato de nodo DSL que RegularizationRule.condition.
//
// Fase 21A (docs/FASE21A_SEED_REGULARIZACION_IDEMPOTENTE_SEGURO.md) —
// `key` es la identidad de negocio estable del seed (slug legible, ej.
// "formulario-12-1"), independiente de `documento` (texto de UI que
// puede corregirse/reescribirse) y de `order` (solo posición visual).
// El seed ahora hace upsert por `key`, nunca borra y recrea — preserva
// el `id` real y por lo tanto cualquier `RegularizationDocumentCheck`
// (progreso real de usuario) que lo referencie.
model RegularizationDocumentChecklist {
  id               String                            @id @default(cuid())
  key              String                            @unique
  documento        String
  category         RegularizationDocumentCategory
  paraQueSirve     String
  dondeSeObtiene   String
  // Ejes normativos — ver enums arriba. obligatoriedad reemplaza al
  // antiguo `obligatorio: Boolean` (Fase 2): MINIMO = lo que antes era
  // `true`, CONDICIONAL = lo que antes era `false`, con el matiz de que
  // ahora es independiente de `origen`/`momento`.
  obligatoriedad   RegularizationDocObligatoriedad
  origen           RegularizationDocOrigen
  momento          RegularizationDocMomento          @default(PREVIO)
  soporteObraBien  RegularizationDocSoporteObraBien
  // Texto libre citando la fuente normativa exacta (ej. "Formulario 12.1,
  // sección 6") — trazabilidad, no un campo estructurado todavía.
  citaNormativa    String
  estadoValidacion RegularizationDocEstadoValidacion @default(VALIDADO)
  dependeDe        Json?
  order            Int                               @default(0)
  // Fase 21A — soft-disable: un documento retirado del seed nunca se
  // borra físicamente si puede tener progreso asociado (ver sección 15
  // del diseño de la fase); en vez de eso queda `active: false` y deja
  // de ofrecerse, igual patrón ya usado en InspectionSpaceTemplate.
  active           Boolean                           @default(true)

  checks RegularizationDocumentCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("regularization_document_checklist")
}

// Estado de "reunido/pendiente" por documento, usuario y caso. A
// diferencia de ShoppingListCheck (clave natural, porque ahí no hay una
// fila catálogo real), acá sí existe un catálogo con id propio
// (RegularizationDocumentChecklist), así que se usa FK real — más fuerte
// en integridad referencial.
model RegularizationDocumentCheck {
  id         String                          @id @default(cuid())
  user       User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  case       RegularizationCase              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  document   RegularizationDocumentChecklist @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  checked Boolean @default(false)

  @@unique([userId, caseId, documentId])
  @@map("regularization_document_checks")
}

// Datos del croquis — estructurado como JSON (muros, medidas, puertas,
// ventanas), nunca una imagen renderizada del lado del servidor.
model RegularizationSketch {
  id     String             @id @default(cuid())
  case   RegularizationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String             @unique

  dataJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("regularization_sketches")
}

// Vincula un paso del checklist inteligente a un QuickGuide existente
// (tutorial "cómo medir un muro", etc.) sin tocar QuickGuide/ProjectTask —
// tabla puente específica en vez de una relación polimórfica genérica (sin
// precedente en este schema; ver decisión documentada de Fase 1).
model RegularizationStepGuide {
  id           String     @id @default(cuid())
  stepKey      String
  quickGuide   QuickGuide @relation(fields: [quickGuideId], references: [id], onDelete: Cascade)
  quickGuideId String
  order        Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepKey])
  @@map("regularization_step_guides")
}

// Motor de evaluación preliminar — reglas determinísticas (tabla de
// condiciones → mensaje), NO IA. `condition` reutiliza el mismo formato de
// nodo DSL y el mismo intérprete (evaluateCondition) que Formula.condition
// — ver src/lib/formula-engine/evaluate.ts. `label` sigue la convención de
// Formula/Variable/LossFactor (identificador legible para administración).
model RegularizationRule {
  id        String  @id @default(cuid())
  label     String
  priority  Int     @default(0)
  enabled   Boolean @default(true)
  condition Json
  message   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, priority])
  @@map("regularization_rules")
}

// ============================================================
// Asesor de Ejecución — motor de recomendación de método de trabajo
// (03-ago-2026). Construido SOLO para Excavación; nombrado de forma
// genérica (sin "excavación" en el schema) porque el motor podría
// reutilizarse para otro módulo en el futuro, pero no se agregó ningún
// campo/mecanismo pensando en esos módulos futuros — todo acá responde
// a una necesidad concreta de Excavación hoy. No toca Regularización
// (RegularizationRule arriba) ni ningún modelo del motor de fórmulas.
// ============================================================

enum ExecutionAdvisorEstado {
  PENDIENTE_VALIDACION
  VALIDADO
}

enum ExecutionAdvisorConfianza {
  ALTA
  MEDIA
  BAJA
}

// Etiqueta de una "consideración" en la explicación de la recomendación —
// nunca "advertencia" (ver Fase 4, UI): son 3 niveles de énfasis textual,
// no severidad de error.
enum ExecutionAdvisorTipoConsideracion {
  TEN_PRESENTE
  CONSIDERACION_IMPORTANTE
  REVISA_ANTES_CONTRATAR
}

// Un asesor por módulo (moduleSlug plano, no relación a Module — el motor
// es intencionalmente independiente del schema del wizard/motor de
// fórmulas, ver decisión de Fase 0: separa "cálculo técnico" de "consejo
// de ejecución"). Hoy solo existirá el registro moduleSlug="excavacion".
model ExecutionAdvisor {
  id         String                 @id @default(cuid())
  moduleSlug String                 @unique
  nombre     String
  estado     ExecutionAdvisorEstado @default(PENDIENTE_VALIDACION)

  options            ExecutionAdvisorOption[]
  rules              ExecutionAdvisorRule[]
  factorExplanations ExecutionAdvisorFactorExplanation[]
  tips               ExecutionAdvisorTip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("execution_advisors")
}

// Catálogo de opciones relevantes para el asesor — inicialmente pensado
// solo como "catálogo de métodos" (manual/mini_excavadora/
// retroexcavadora/excavadora), pero `reduceConfidence` (04-ago-2026)
// obliga a ampliar su alcance: para que el motor pueda leer si LA
// RESPUESTA QUE ACTIVÓ el factor decisivo (ej. acceso="no_seguro") baja
// la confianza, esa opción también tiene que existir acá con su flag —
// no solo las opciones de método. El nombre describe el EFECTO sobre el
// motor (baja confianza si esta opción fue la respuesta decisiva), no
// interpreta el significado de la respuesta (deliberadamente no se llama
// "esIncierto" — ver auditoría 04-ago-2026 sobre variantes de
// incertidumbre en el proyecto, ninguna coincide con este concepto).
//
// Actualización (04-ago-2026, Fase 4): la restricción anterior ("no tiene
// ni tendrá un campo tipo/categoria") queda revertida — apareció un
// consumidor real. El fallback de Fase 4 (ver action.ts) necesita
// distinguir "el usuario eligió un método real que ninguna regla
// recomienda" (mostrar un mensaje amistoso) de "la respuesta no es un
// método reconocible en absoluto" (inconsistencia de configuración, no
// renderizar nada) — `evaluate.ts:detectarEleccionUsuario` (que deriva
// "método válido" de qué reglas existen) no puede hacer esa distinción,
// porque ambos casos le dan el mismo `null`. `tipo` SOLO se usa en
// action.ts (capa de ensamblaje, Fase 4) — evaluate.ts (el motor puro de
// Fase 2) no lo lee y no cambió.
enum ExecutionAdvisorOptionTipo {
  METODO
  ACCESO
  TERRENO
}

model ExecutionAdvisorOption {
  id               String                     @id @default(cuid())
  advisor          ExecutionAdvisor           @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId        String
  key              String
  label            String
  descripcion      String?
  tipo             ExecutionAdvisorOptionTipo
  // Si esta opción fue la respuesta que activó el factor de mayor peso
  // (el "factor decisivo"), el motor baja la confianza un nivel respecto
  // al techo de la regla (ver evaluarAsesorEjecucion). No aplica a menos
  // que esta opción sea justo la decisiva — no es una propiedad "de
  // fábrica" de la opción en abstracto.
  reduceConfidence Boolean                    @default(false)

  @@unique([advisorId, key])
  @@map("execution_advisor_options")
}

// Regla de recomendación — se evalúan en cascada por `prioridad` (no en
// paralelo, ver motor de Fase 2): la primera cuyas `condiciones` calcen
// TODAS (AND) decide la recomendación. `condiciones` es una lista plana
// — NO reutiliza el árbol de nodos DSL de Formula.condition/
// RegularizationRule.condition (ver comentario en RegularizationRule
// arriba) porque lo que hace falta acá es más simple: una lista de
// comparaciones AND-eadas, no expresiones anidadas. Formato de cada
// elemento: { questionKey: string, operador: "equals" | "in", valor:
// string | string[] }.
model ExecutionAdvisorRule {
  id                   String                    @id @default(cuid())
  advisor              ExecutionAdvisor          @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId            String
  prioridad            Int
  condiciones          Json
  opcionRecomendadaKey String
  // Techo de confianza — el motor (Fase 2) puede bajarla un nivel según el
  // factor decisivo, nunca subirla por sobre este valor.
  confianzaBase        ExecutionAdvisorConfianza
  estado               ExecutionAdvisorEstado    @default(PENDIENTE_VALIDACION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advisorId, prioridad])
  @@map("execution_advisor_rules")
}

// Fragmento de explicación por factor (ej. "el acceso es solo peatonal" /
// "el terreno tiene arcilla") — el motor arma `recomendacion.explicacion`
// ordenando estos fragmentos por `peso` (mayor peso = factor más decisivo,
// también el que determina si la confianza baja un nivel, ver
// ExecutionAdvisorRule.confianzaBase). `condicion` usa el mismo formato
// de comparación simple que ExecutionAdvisorRule.condiciones (un único
// elemento, no una lista), no el árbol de Formula.condition.
model ExecutionAdvisorFactorExplanation {
  id                 String                             @id @default(cuid())
  advisor            ExecutionAdvisor                   @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId          String
  factorQuestionKey  String
  condicion          Json
  fragmentoTexto     String
  peso               Int
  tipoConsideracion  ExecutionAdvisorTipoConsideracion?
  textoConsideracion String?
  estado             ExecutionAdvisorEstado             @default(PENDIENTE_VALIDACION)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advisorId, peso])
  @@map("execution_advisor_factor_explanations")
}

// Tips de "antes de comenzar" — se filtran SIEMPRE por la elección REAL
// del usuario (aplicaAOpcionKey === eleccionUsuario.metodoKey), nunca por
// la recomendación (ver Fase 2, antesDeComenzar.tips).
model ExecutionAdvisorTip {
  id               String                 @id @default(cuid())
  advisor          ExecutionAdvisor       @relation(fields: [advisorId], references: [id], onDelete: Cascade)
  advisorId        String
  aplicaAOpcionKey String
  texto            String
  orden            Int                    @default(0)
  estado           ExecutionAdvisorEstado @default(PENDIENTE_VALIDACION)

  @@index([advisorId, aplicaAOpcionKey])
  @@map("execution_advisor_tips")
}

// ============================================================
// Inspecciones — Fase 1 (14-ago-2026): SOLO capa de datos, aprobada tras
// diseño v1.1 (revisión que separó explícitamente catálogo vs. instancia
// real agregando InspectionElement). Sin UI, sin Server Actions de
// negocio, sin rutas — ver el documento de diseño para el detalle
// completo de cada decisión si hace falta reconstruir el porqué.
//
// Dos árboles sin flechas cruzadas entre sí salvo las relaciones
// FK-nullable-con-snapshot descritas abajo:
//   CATÁLOGO:    InspectionSpaceTemplate -> InspectionElementTemplate -> InspectionChecklistItem
//   INSPECCIÓN:  InspectionCase -> InspectionSpace -> InspectionElement -> InspectionChecklistCheck -> InspectionObservation
// ============================================================

enum InspectionPropertyType {
  CASA
  DEPARTAMENTO
  AMPLIACION
}

// Fase 11B — motivo de la inspección (docs/FASE11A_DISENO_INSPECCION_TECNICA_GUIADA.md,
// sección 2). Nullable: los casos V1 ya existentes no tienen motivo
// declarado y deben seguir funcionando exactamente igual (ver informe de
// Fase 11B, "Compatibilidad con V1") — nunca se retroactivea ni se
// asume un valor por defecto para datos históricos.
enum InspectionMotivo {
  RECEPCION_PRE_FIRMA
  POST_RECEPCION
  REVISION_AMPLIACION
}

// Fase 11B — qué se está ampliando, solo aplica cuando
// tipoInmueble = AMPLIACION (docs/..., sección 5). Reemplaza el concepto
// único de "Recinto ampliado" por 7 tipos concretos; OTRO preserva el
// comportamiento genérico de V1 sin cambios.
enum InspectionTipoAmpliacion {
  COCINA
  DORMITORIO
  DORMITORIO_BANO
  LIVING_COMEDOR
  SEGUNDO_PISO
  TERRAZA_CERRADA
  OTRO
}

enum InspectionCaseStatus {
  DRAFT
  IN_PROGRESS
  CLOSED
}

enum InspectionAnswerStatus {
  OK
  OBSERVATION
  NOT_APPLICABLE
}

enum InspectionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InspectionObservationStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum InspectionPhotoKind {
  GENERAL
  EVIDENCE
  GOOD_CONDITION
  FUTURE_REPAIR
  // Fase 11K (docs/FASE11J_REDISENO_PROFUNDO_INSPECCION_GUIADA.md,
  // sección E) — foto de portada del caso, siempre a nivel `case` (spaceId/
  // elementId/observationId null). A lo más 1 activa por caso — invariante
  // aplicada en la Server Action (mismo criterio ya usado en el resto del
  // módulo: "el nivel más específico presente es el que aplica" nunca se
  // hizo cumplir en el schema, solo en la capa de aplicación).
  COVER
}

// ---------- CATÁLOGO (qué SE PUEDE inspeccionar) ----------

model InspectionSpaceTemplate {
  id         String                   @id @default(cuid())
  key        String                   @unique
  label      String
  appliesTo  InspectionPropertyType[]
  repeatable Boolean                  @default(false)
  order      Int                      @default(0)
  // Soft-delete: un template nunca se borra físicamente en operación
  // normal (rompería onDelete: SetNull de instancias ya generadas y la
  // integridad histórica de esas inspecciones) — se retira desactivándolo.
  active     Boolean                  @default(true)

  // N:N con InspectionElementTemplate (ver InspectionElementTemplateSpace)
  // — "Piso" es UNA fila de catálogo aplicable a Cocina, Dormitorio, Baño
  // y Living a la vez, no una copia por espacio (decisión confirmada en
  // Fase 1, 14-ago-2026: la FK simple original no permitía esto).
  elementTemplateLinks InspectionElementTemplateSpace[]
  spaces               InspectionSpace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inspection_space_templates")
}

model InspectionElementTemplate {
  id                String                   @id @default(cuid())
  key               String                   @unique
  label             String
  order             Int                      @default(0)
  appliesTo         InspectionPropertyType[]
  // Referencia libre (no FK) al `key` de un elemento "padre" para agrupar
  // variantes de material (ej. "piso-ceramico"/"piso-flotante" bajo
  // "piso") — sin tabla de variantes dedicada en v1.
  materialVariantOf String?
  active            Boolean                  @default(true)

  spaceTemplateLinks InspectionElementTemplateSpace[]
  checklistItems     InspectionChecklistItem[]
  elements           InspectionElement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inspection_element_templates")
}

// Tabla puente N:N — un mismo InspectionElementTemplate ("Piso") puede
// sugerirse en múltiples InspectionSpaceTemplate ("Cocina", "Dormitorio",
// "Baño", "Living") sin duplicar la fila de catálogo. Reemplaza la FK
// simple `InspectionElementTemplate.spaceTemplateId` de la primera
// versión migrada de este schema (corrección encontrada al construir el
// seed mínimo — ver Fase 1, 14-ago-2026).
model InspectionElementTemplateSpace {
  id                String                    @id @default(cuid())
  spaceTemplate     InspectionSpaceTemplate   @relation(fields: [spaceTemplateId], references: [id], onDelete: Cascade)
  spaceTemplateId   String
  elementTemplate   InspectionElementTemplate @relation(fields: [elementTemplateId], references: [id], onDelete: Cascade)
  elementTemplateId String
  // Orden de este elemento DENTRO de este espacio en particular — el
  // mismo "Piso" puede ir primero en Cocina y tercero en Dormitorio.
  order             Int                       @default(0)

  createdAt DateTime @default(now())

  @@unique([spaceTemplateId, elementTemplateId])
  @@index([elementTemplateId])
  @@map("inspection_element_template_spaces")
}

model InspectionChecklistItem {
  id                   String                    @id @default(cuid())
  elementTemplate      InspectionElementTemplate @relation(fields: [elementTemplateId], references: [id], onDelete: Cascade)
  elementTemplateId    String
  question             String
  helpText             String?
  order                Int                       @default(0)
  // Mismo formato de nodo DSL que Formula.condition/RegularizationRule.condition
  // (ver docs/formula-dsl.md) — opcional, sin uso todavía en el seed mínimo.
  condition            Json?
  defaultSeverity      InspectionSeverity?
  // Referencia libre (no FK) a TechnicalArticle.slug — el catálogo
  // operativo debe poder existir sin que exista todavía el artículo.
  technicalArticleSlug String?
  active               Boolean                   @default(true)

  checks InspectionChecklistCheck[]
  // Fase 11O (docs/FASE11O_INFORME_MODELO_REFERENCIAS_VISUALES.md) —
  // contenido educativo BIEN/MAL de esta revisión específica. Separado a
  // propósito de InspectionPhoto (ver esa nota en InspectionReferenceImage
  // más abajo). FK directa al checklist item, no al elemento completo:
  // la imagen ilustra UNA revisión puntual ("Vidrio"), no todo "Ventana".
  referenceImages InspectionReferenceImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([elementTemplateId])
  @@map("inspection_checklist_items")
}

// ---------- INSPECCIÓN REAL (qué FUE inspeccionado) ----------

model InspectionCase {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  name         String
  direccion    String?
  tipoInmueble InspectionPropertyType
  fecha        DateTime?
  estado       InspectionCaseStatus   @default(DRAFT)

  // Fase 11B — ver docs/FASE11A_DISENO_INSPECCION_TECNICA_GUIADA.md,
  // sección 8C: ambos nullable a propósito (compatibilidad con casos V1
  // ya existentes, que no tienen ninguno de los dos) y porque
  // `tipoAmpliacion` solo tiene sentido cuando `tipoInmueble = AMPLIACION`.
  motivo         InspectionMotivo?
  tipoAmpliacion InspectionTipoAmpliacion?

  bedroomCount  Int?
  bathroomCount Int?

  observacionesGenerales String?

  spaces InspectionSpace[]
  photos InspectionPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("inspection_cases")
}

model InspectionSpace {
  id     String         @id @default(cuid())
  case   InspectionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  spaceTemplate   InspectionSpaceTemplate? @relation(fields: [spaceTemplateId], references: [id], onDelete: SetNull)
  spaceTemplateId String?

  // Snapshot del label del template al generarse ("Dormitorio 1") —
  // editable después, independiente de lo que le pase al template.
  name     String
  order    Int     @default(0)
  // true si el usuario agregó este espacio sin partir de un template del
  // catálogo (ver InspectionElement.isCustom, mismo criterio).
  isCustom Boolean @default(false)

  // Fase 11Y — configuración Nivel 2 del recinto (docs/FASE11Y_INFORME_
  // PILOTO_CONFIGURACION_NIVEL2.md). Genérico y extensible a propósito:
  // NO se modela como una columna por componente (`hasReja`, `hasPorton`,
  // futuros `hasTina`/`hasLavaplatos`) porque eso no escala a Cocina/Baño.
  // Shape: `{ components?: Record<elementTemplateKey, boolean>,
  // componentMeta?: Record<elementTemplateKey, Record<string, string>> }`.
  // Nullable/aditivo: espacios existentes (histórico) siguen con
  // `config: null` sin romper nada — su compatibilidad se resuelve en
  // lectura (ver src/lib/inspecciones/space-config.ts), nunca escribiendo
  // retroactivamente sobre casos reales.
  config Json?

  elements InspectionElement[]
  photos   InspectionPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([spaceTemplateId])
  @@map("inspection_spaces")
}

model InspectionElement {
  id      String          @id @default(cuid())
  space   InspectionSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceId String

  elementTemplate   InspectionElementTemplate? @relation(fields: [elementTemplateId], references: [id], onDelete: SetNull)
  elementTemplateId String?

  name     String
  order    Int     @default(0)
  isCustom Boolean @default(false)

  checks InspectionChecklistCheck[]
  photos InspectionPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([elementTemplateId])
  @@map("inspection_elements")
}

model InspectionChecklistCheck {
  id        String            @id @default(cuid())
  element   InspectionElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  elementId String

  checklistItem   InspectionChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Restrict)
  checklistItemId String

  // Texto copiado de InspectionChecklistItem.question al generarse —
  // estabilidad histórica: si el catálogo cambia después, esta respuesta
  // ya generada sigue mostrando exactamente lo que se preguntó.
  questionSnapshot String
  status           InspectionAnswerStatus?
  answeredAt       DateTime?
  // Fase 11K (docs/FASE11J_REDISENO_PROFUNDO_INSPECCION_GUIADA.md,
  // sección Q) — motivo opcional cuando status = NOT_APPLICABLE. Nunca se
  // modela como InspectionObservation (esa trae severidad/estado que no
  // aplican semánticamente a "no corresponde"). Se limpia explícitamente
  // en la Server Action cada vez que el status cambia a otro valor, para
  // que nunca quede un motivo huérfano de un estado distinto.
  notApplicableReason String?

  observations InspectionObservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([elementId, checklistItemId])
  @@index([elementId])
  @@map("inspection_checklist_checks")
}

// 1:N respecto a InspectionChecklistCheck (NO @@unique en checklistCheckId)
// — un mismo punto de inspección puede tener varios hallazgos distintos
// (ej. fisura + humedad bajo la misma pregunta), cada uno con su propia
// severidad/recomendación/estado.
model InspectionObservation {
  id               String                   @id @default(cuid())
  checklistCheck   InspectionChecklistCheck @relation(fields: [checklistCheckId], references: [id], onDelete: Cascade)
  checklistCheckId String

  comment        String
  severity       InspectionSeverity
  recommendation String?
  status         InspectionObservationStatus @default(OPEN)

  photos InspectionPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistCheckId])
  @@map("inspection_observations")
}

// Cuatro niveles de relación, todos opcionales salvo caseId — el nivel
// más específico presente es el que aplica (ver diseño v1.1, sección de
// fotografías): esta invariante NO está enforced por la base de datos,
// queda como responsabilidad de la futura Server Action de subida.
model InspectionPhoto {
  id String @id @default(cuid())

  case   InspectionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  space   InspectionSpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  spaceId String?

  element   InspectionElement? @relation(fields: [elementId], references: [id], onDelete: SetNull)
  elementId String?

  observation   InspectionObservation? @relation(fields: [observationId], references: [id], onDelete: SetNull)
  observationId String?

  kind    InspectionPhotoKind
  url     String
  caption String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
  @@index([spaceId])
  @@index([elementId])
  @@index([observationId])
  @@map("inspection_photos")
}

// Biblioteca técnica ("cómo se revisa X") — capa separada del catálogo
// operativo (InspectionChecklistItem.technicalArticleSlug la referencia
// débilmente) para no repetir el problema de bibliotecas paralelas.
model TechnicalArticle {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  content String
  order   Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("technical_articles")
}

// Fase 11O (docs/FASE11M_DISENO_MOTOR_REVISIONES_VARIANTES.md, sección L;
// docs/FASE11O_INFORME_MODELO_REFERENCIAS_VISUALES.md) — contenido
// educativo BIEN/MAL del catálogo, deliberadamente SEPARADO de
// InspectionPhoto:
//   InspectionPhoto          = evidencia tomada por el usuario DURANTE una
//                              inspección real (ligada a case/space/
//                              element/observation, sube el inspector).
//   InspectionReferenceImage = material curado por el equipo, IGUAL para
//                              todos los usuarios que revisen ese mismo
//                              InspectionChecklistItem — vive en el
//                              catálogo, nunca en una inspección real.
// Nunca deben mezclarse en la misma tabla ni en el mismo flujo de subida.
enum InspectionReferenceImageKind {
  GOOD
  BAD
}

model InspectionReferenceImage {
  id              String                        @id @default(cuid())
  // FK directa al checklist item (no al elemento completo) — la imagen
  // ilustra UNA revisión específica, mismo criterio de granularidad de
  // Fase 11M. Cascade: si se elimina la pregunta del catálogo, sus
  // referencias visuales dejan de tener sentido y se eliminan con ella
  // (mismo patrón ya usado por InspectionChecklistItem → elementTemplate).
  // Esto borra FILAS de BD, nunca el blob físico — cualquier UI futura
  // que permita borrar una referencia deberá llamar del(url) antes o
  // durante el borrado, igual que el patrón ya validado para
  // InspectionPhoto (deleteObservationAction, Fase 10Q).
  checklistItem   InspectionChecklistItem       @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  checklistItemId String
  kind            InspectionReferenceImageKind
  url             String
  // Obligatorio a propósito: contenido educativo, debe ser accesible
  // (ej. "Ventana con sello continuo entre hoja y marco").
  alt             String
  // Opcional — leyenda breve mostrada junto a la imagen (ej. "Sello
  // continuo, sin separación visible"). NO reemplaza a TechnicalArticle:
  // TechnicalArticle explica, ReferenceImage ilustra — no se mezclan.
  caption         String?
  // Sin @@unique([checklistItemId, kind]) a propósito — permite más de
  // una imagen GOOD y más de una BAD por revisión; `order` da el orden
  // estable entre ellas dentro del mismo kind.
  order           Int                           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistItemId])
  @@map("inspection_reference_images")
}
